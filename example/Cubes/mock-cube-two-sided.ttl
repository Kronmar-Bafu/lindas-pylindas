@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://mock.ld.admin.ch/mock-two-sided/1> a void:Dataset,
        schema:Dataset,
        dcat:Dataset,
        cube:Cube ;
    dct:accrualPeriodicity <http://publications.europe.eu/resource/authority/frequency/ANNUAL> ;
    dct:creator <https://register.ld.admin.ch/opendataswiss/org/office_of_Mock> ;
    dct:identifier "mock-two-sided" ;
    schema:contactPoint [ a schema:ContactPoint ;
            schema:email "contact@mock.ld.admin.ch"^^xsd:string ;
            schema:name "Bundesamt für Mock Data"^^xsd:string ] ;
    schema:contributor <https://register.ld.admin.ch/opendataswiss/org/bundesamt-fur-umwelt-bafu> ;
    schema:creativeWorkStatus <https://ld.admin.ch/vocabulary/CreativeWorkStatus/Published> ;
    schema:creator <https://register.ld.admin.ch/opendataswiss/org/office_of_Mock> ;
    schema:dateCreated "2024-11-12"^^xsd:date ;
    schema:dateModified "2026-10-21T09:25:08+00:00"^^xsd:dateTime ;
    schema:datePublished "2026-10-21"^^xsd:date ;
    schema:description "Ein Beispiel Cube, der simulierte Daten enthält mit zweiseitiger Unsicherheit"@de,
        "An example Cube containing some simulated data with two-sided uncertainty"@en ;
    schema:name "Mock Cube - two sided error"@de,
        "Mock Cube - two sided error"@en,
        "Mock Cube - two sided error"@fr,
        "Mock Cube - two sided error"@it ;
    schema:publisher <https://register.ld.admin.ch/opendataswiss/org/office_of_Mock> ;
    schema:version 1 ;
    schema:workExample <https://ld.admin.ch/application/visualize> ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:fn "Bundesamt für Mock Data"^^xsd:string ;
            vcard:hasEmail "contact@mock.ld.admin.ch"^^xsd:string ] ;
    cube:observationConstraint <https://mock.ld.admin.ch/mock-two-sided/1/shape> ;
    cube:observationSet <https://mock.ld.admin.ch/mock-two-sided/1/ObservationSet> .

<https://mock.ld.admin.ch/mock-two-sided/1/ObservationSet> a cube:ObservationSet ;
    cube:observation <https://mock.ld.admin.ch/mock-two-sided/1/observation/2000_Bern>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2000_Schweiz>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2000_Z%C3%BCrich>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2001_Bern>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2001_Schweiz>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2001_Z%C3%BCrich>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2002_Bern>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2002_Schweiz>,
        <https://mock.ld.admin.ch/mock-two-sided/1/observation/2002_Z%C3%BCrich> .

