<https://environment.ld.admin.ch/foen/biotopes/UZ-2404/1/shape> a sh:NodeShape,
        cube:Constraint ;
    sh:closed true ;
    sh:property [ a cube:KeyDimension ;
            qudt:scaleType qudt:NominalScale ;
            schema:description "Die Art des Biotopes nach denen in der Biotopstatistik unterschieden wird"@de ;
            schema:name "Art des Biotops"@de,
                "Art des Biotops"@en,
                "Art des Biotops"@fr,
                "Art des Biotops"@it ;
            sh:in ( biotop:1 biotop:2 biotop:3 biotop:4 biotop:5 biotop:tot ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path biotop:type ;
            meta:inHierarchy [ a meta:Hierarchy ;
                    schema:name "Biotope" ;
                    meta:hierarchyRoot biotop:tot ;
                    meta:nextInHierarchy [ schema:name "Biotoparten" ;
                            sh:path schema:hasPart ] ] ],
        [ a cube:KeyDimension ;
            qudt:scaleType qudt:NominalScale ;
            schema:description "Die Fläche kann einzeln pro Objekt oder überlappend betrachtet werden."@de ;
            schema:name "Überlappung"@de,
                "Überlappung"@en,
                "Überlappung"@fr,
                "Überlappung"@it ;
            sh:in ( <https://environment.ld.admin.ch/foen/overlapping/1> <https://environment.ld.admin.ch/foen/overlapping/2> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path biotop:overlap ],
        [ sh:in ( <https://register.ld.admin.ch/opendataswiss/org/bundesamt-fur-umwelt-bafu> ) ;
            sh:nodeKind sh:IRI ;
            sh:path cube:observedBy ],
        [ a cube:MeasureDimension ;
            qudt:hasUnit unit:PERCENT ;
            qudt:scaleType qudt:RatioScale ;
            schema:description "Anteil der Objekte an der Gesamtfläche der Schweiz"@de ;
            schema:name "Anteil CH-Fläche"@de,
                "Anteil CH-Fläche"@en,
                "Anteil CH-Fläche"@fr,
                "Anteil CH-Fläche"@it ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive "2.47"^^xsd:float ;
            sh:minCount 1 ;
            sh:minInclusive "0.04"^^xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:path biotop:area_of_switzerland ],
        [ a cube:MeasureDimension ;
            qudt:hasUnit unit:PERCENT ;
            qudt:scaleType qudt:RatioScale ;
            schema:description "Anteil der Objekte an Gesamtmenge der Biotope"@de ;
            schema:name "Anteil der CH-Biotope"@de,
                "Anteil der CH-Biotope"@en,
                "Anteil der CH-Biotope"@fr,
                "Anteil der CH-Biotope"@it ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive "100.0"^^xsd:float ;
            sh:minCount 1 ;
            sh:minInclusive "4.6"^^xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:path biotop:ratio_of_objects ],
        [ a cube:MeasureDimension ;
            qudt:hasUnit unit:UNITLESS ;
            qudt:scaleType qudt:RatioScale ;
            schema:description "Anzahl der Objekte"@de ;
            schema:name "Anzahl Objekte"@de,
                "Anzahl Objekte"@en,
                "Anzahl Objekte"@fr,
                "Anzahl Objekte"@it ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 7092 ;
            sh:minCount 1 ;
            sh:minInclusive 326 ;
            sh:nodeKind sh:Literal ;
            sh:path biotop:count ],
        [ a cube:MeasureDimension ;
            qudt:hasUnit unit:HA ;
            qudt:scaleType qudt:RatioScale ;
            schema:description "Summe der Flächen der Objekte"@de ;
            schema:name "Fläche der Objekte"@de,
                "Fläche der Objekte"@en,
                "Fläche der Objekte"@fr,
                "Fläche der Objekte"@it ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive "101864.9"^^xsd:float ;
            sh:minCount 1 ;
            sh:minInclusive "1567.5"^^xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:path biotop:area ],
        [ sh:in ( cube:Observation ) ;
            sh:nodeKind sh:IRI ;
            sh:path rdf:type ],
        [ a cube:MeasureDimension ;
            qudt:hasUnit unit:PERCENT ;
            qudt:scaleType qudt:RatioScale ;
            schema:description "Anteil der Objekte an der Gesamtfläche aller Objekte in der Biotopstatistik"@de ;
            schema:name "Anteil der CH-Biotope (Fläche)"@de,
                "Anteil der CH-Biotope (Fläche)"@en,
                "Anteil der CH-Biotope (Fläche)"@fr,
                "Anteil der CH-Biotope (Fläche)"@it ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive "100.0"^^xsd:float ;
            sh:minCount 1 ;
            sh:minInclusive "1.5"^^xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:path biotop:area_of_biotopes ] .

